{
  "name": "@roos-code/roos-code-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Roos Code",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@roos-code/cordis-plugin-include": "workspace:^",
    "@roos-code/cordis-plugin-loader": "workspace:^",
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-atomic-write": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-home-paths": "workspace:^",
    "@roos-code/roos-code-scope": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-settings": "workspace:^",
    "@roos-code/roos-code-system-prompt": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@roos-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/cordis-plugin-include": "workspace:^",
    "@roos-code/cordis-plugin-loader": "workspace:^",
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-agent-loop": "workspace:^",
    "@roos-code/roos-code-atomic-write": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-home-paths": "workspace:^",
    "@roos-code/roos-code-scope": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-settings": "workspace:^",
    "@roos-code/roos-code-settings-file": "workspace:^",
    "@roos-code/roos-code-system-prompt": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
