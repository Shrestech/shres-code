{
  "name": "@roos-code/roos-code-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@roos-code/roos-code-attachment": "workspace:^",
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-agent-default-model": "workspace:^",
    "@roos-code/roos-code-api-remotes": "workspace:^",
    "@roos-code/roos-code-brand": "workspace:^",
    "@roos-code/roos-code-commands": "workspace:^",
    "@roos-code/roos-code-credentials": "workspace:^",
    "@roos-code/roos-code-goal": "workspace:^",
    "@roos-code/roos-code-host-directory-picker": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-native-command": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-session-persistence": "workspace:^",
    "@roos-code/roos-code-session-projection": "workspace:^",
    "@roos-code/roos-code-session-projection-cache": "workspace:^",
    "@roos-code/roos-code-session-query": "workspace:^",
    "@roos-code/roos-code-session-title": "workspace:^",
    "@roos-code/roos-code-settings": "workspace:^",
    "@roos-code/roos-code-skill": "workspace:^",
    "@roos-code/roos-code-subagent": "workspace:^",
    "@roos-code/roos-code-jobs": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "@roos-code/roos-code-user-approval": "workspace:^",
    "@roos-code/roos-code-user-questions": "workspace:^",
    "@roos-code/roos-code-workspace": "workspace:^",
    "@roos-code/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@roos-code/cordis": "workspace:^",
    "@roos-code/roos-code-agent-presets": "workspace:^",
    "@roos-code/roos-code-cordis-host-runner": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/cordis": "workspace:^",
    "@roos-code/roos-code-agent-presets": "workspace:^",
    "@roos-code/roos-code-cordis-host-runner": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-storage": "workspace:^",
    "@roos-code/roos-code-storage-domain": "workspace:^",
    "@roos-code/roos-code-typert-protocol": "workspace:^",
    "@roos-code/roos-code-typert-registry": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
