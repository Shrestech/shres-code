{
  "name": "@shres-code/shres-code-host-plugin-admin",
  "description": "Gesture-gated Remote namespace over the shared plugin and skill install core: status, parked install transactions, and skill add/remove for the booted profile",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/host/plugin-admin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@shres-code/cordis": "workspace:^",
    "@shres-code/shres-code-app-boot": "workspace:^",
    "@shres-code/shres-code-brand": "workspace:^",
    "@shres-code/shres-code-host-remote-control": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/schemastery": "workspace:^",
    "@shres-code/shres-code-skill": "workspace:^",
    "@shres-code/shres-code-skill-filesystem": "workspace:^",
    "@shres-code/shres-code-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/cordis": "workspace:^",
    "@shres-code/shres-code-app-boot": "workspace:^",
    "@shres-code/shres-code-brand": "workspace:^",
    "@shres-code/shres-code-host-remote-control": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/schemastery": "workspace:^",
    "@shres-code/shres-code-skill": "workspace:^",
    "@shres-code/shres-code-skill-filesystem": "workspace:^",
    "@shres-code/shres-code-typert-protocol": "workspace:^"
  }
}
