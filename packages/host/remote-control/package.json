{
  "name": "@shres-code/shres-code-host-remote-control",
  "description": "Remote connect for the Shres Code web GUI: a durable remote registry, an ssh tunnel controller, and the identity/version primitives the CLI and host plugin share",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/host/remote-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./gateway": {
      "types": "./lib/types/gateway.d.ts",
      "default": "./lib/gateway.js"
    },
    "./home": {
      "types": "./lib/types/home.d.ts",
      "default": "./lib/home.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/gateway.js",
    "lib/home.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/cordis": "workspace:^",
    "@shres-code/shres-code-atomic-write": "workspace:^",
    "@shres-code/shres-code-brand": "workspace:^",
    "@shres-code/shres-code-home-paths": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/cordis": "workspace:^",
    "@shres-code/shres-code-atomic-write": "workspace:^",
    "@shres-code/shres-code-brand": "workspace:^",
    "@shres-code/shres-code-home-paths": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
