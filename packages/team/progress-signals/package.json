{
  "name": "@shres-code/shres-code-progress-signals",
  "description": "Pure progress-signal folds over a committed session log: five stuck-trigger verdicts, the numbers-first progress facts that measure the same runs, the trailing tool window, and the identical-call chain key",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/team/progress-signals"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-jspace": "workspace:^",
    "@shres-code/shres-code-sandbox": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-step-budget": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@shres-code/shres-code-jspace": {
      "optional": true
    },
    "@shres-code/shres-code-step-budget": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-jspace": "workspace:^",
    "@shres-code/shres-code-sandbox": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-step-budget": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
