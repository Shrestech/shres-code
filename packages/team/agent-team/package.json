{
  "name": "@shres-code/shres-code-agent-team",
  "description": "Agent Teams runtime: Lead-log mailbox, continuable teammate provisioning, steer delivery, and team_send / team_list",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/team/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@shres-code/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-brand": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-session-persistence": "workspace:^",
    "@shres-code/shres-code-session-projection": "workspace:^",
    "@shres-code/shres-code-subagent": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-agent-loop": "workspace:^",
    "@shres-code/shres-code-agent-loop-testkit": "workspace:^",
    "@shres-code/shres-code-brand": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-session-persistence": "workspace:^",
    "@shres-code/shres-code-session-persistence-jsonl": "workspace:^",
    "@shres-code/shres-code-session-projection": "workspace:^",
    "@shres-code/shres-code-subagent": "workspace:^",
    "@shres-code/shres-code-subagent-spawn-in-process": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/cordis": "workspace:^",
    "@shres-code/cordis-plugin-loader": "workspace:^"
  }
}
