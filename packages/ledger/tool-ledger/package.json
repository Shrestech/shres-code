{
  "name": "@shres-code/shres-code-tool-ledger",
  "description": "Model-facing decision-ledger tools — ledger_record_decision, ledger_query — over the ctx.ledger seam, surfacing the validation failure taxonomy verbatim",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/ledger/tool-ledger"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-ledger": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/shres-code-tracker": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-ledger": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/shres-code-tracker": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
