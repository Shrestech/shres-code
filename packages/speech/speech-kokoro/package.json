{
  "name": "@shres-code/shres-code-speech-kokoro",
  "description": "Local Kokoro-82M TTS provider for the Shres Code speech capability seam (ctx.speech)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/speech/speech-kokoro"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-home-paths": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-speech": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@shres-code/schemastery": "workspace:^",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@shres-code/shres-code-home-paths": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-speech": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
