{
  "name": "@shres-code/shres-code-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/terminal/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-terminal": "workspace:^",
    "@shres-code/shres-code-output-retention": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/shres-code-jobs": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/cordis-plugin-include": "workspace:^",
    "@shres-code/cordis-plugin-loader": "workspace:^",
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-terminal": "workspace:^",
    "@shres-code/shres-code-terminal-bash": "workspace:^",
    "@shres-code/shres-code-output-retention": "workspace:^",
    "@shres-code/shres-code-sandbox": "workspace:^",
    "@shres-code/shres-code-sandbox-policy": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-subprocess-local": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/shres-code-jobs": "workspace:^",
    "@shres-code/shres-code-jobs-local": "workspace:^",
    "@shres-code/shres-code-tool-jobs": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
