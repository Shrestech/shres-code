{
  "name": "@shres-code/shres-code-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the Shres Code interception seams",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-hook-protocol": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-session-persistence": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-agent-loop": "workspace:^",
    "@shres-code/shres-code-agent-loop-testkit": "workspace:^",
    "@shres-code/shres-code-shell": "workspace:^",
    "@shres-code/shres-code-bash-local": "workspace:^",
    "@shres-code/shres-code-subprocess-local": "workspace:^",
    "@shres-code/shres-code-hook-protocol": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-session-persistence": "workspace:^",
    "@shres-code/shres-code-session-persistence-jsonl": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
