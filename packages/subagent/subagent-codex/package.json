{
  "name": "@shres-code/shres-code-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-sdk-protocol": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-subagent": "workspace:^",
    "@shres-code/shres-code-subprocess": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/cordis-plugin-loader": "workspace:^",
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-loader-smoke": "workspace:^",
    "@shres-code/shres-code-sdk-protocol": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-subagent": "workspace:^",
    "@shres-code/shres-code-subprocess": "workspace:^",
    "@shres-code/shres-code-subprocess-local": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@openai/codex": "0.147.0",
    "@shres-code/cordis": "workspace:^"
  }
}
