{
  "name": "@roos-code/roos-code-fs-sandbox",
  "description": "Sandbox-enforcing implementation of the Roos Code filesystem seam: fences write/edit by the per-call sandbox mode and denies credential-document reads except under danger-full-access",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/fs/fs-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@roos-code/roos-code-fs": "workspace:^",
    "@roos-code/roos-code-fs-local": "workspace:^",
    "@roos-code/roos-code-home-paths": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-sandbox": "workspace:^",
    "@roos-code/roos-code-sandbox-policy": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@roos-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/roos-code-fs": "workspace:^",
    "@roos-code/roos-code-fs-local": "workspace:^",
    "@roos-code/roos-code-home-paths": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-sandbox": "workspace:^",
    "@roos-code/roos-code-sandbox-policy": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
