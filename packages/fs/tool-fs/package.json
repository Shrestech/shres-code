{
  "name": "@roos-code/roos-code-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the Roos Code filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@roos-code/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@roos-code/roos-code-attachment": "workspace:^",
    "@roos-code/roos-code-fs": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-sandbox": "workspace:^",
    "@roos-code/roos-code-sandbox-policy": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-system-prompt": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "@roos-code/roos-code-user-approval": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-agent-loop": "workspace:^",
    "@roos-code/roos-code-agent-loop-testkit": "workspace:^",
    "@roos-code/roos-code-attachment": "workspace:^",
    "@roos-code/roos-code-fs": "workspace:^",
    "@roos-code/roos-code-fs-local": "workspace:^",
    "@roos-code/roos-code-fs-sandbox": "workspace:^",
    "@roos-code/roos-code-fs-observation-policy": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-llm-deepseek": "workspace:^",
    "@roos-code/roos-code-sandbox": "workspace:^",
    "@roos-code/roos-code-sandbox-policy": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-system-prompt": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "@roos-code/roos-code-user-approval": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
