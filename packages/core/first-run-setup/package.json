{
  "name": "@shres-code/shres-code-first-run-setup",
  "description": "First-run model picker: local Ollama detection, CLI menu, and settings/credential writes",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/core/first-run-setup"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@shres-code/shres-code-agent-default-model": "workspace:^",
    "@shres-code/shres-code-credentials": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-llm-pi-ai": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/cordis-plugin-include": "workspace:^",
    "@shres-code/cordis-plugin-loader": "workspace:^",
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-agent-default-model": "workspace:^",
    "@shres-code/shres-code-credentials": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-llm-pi-ai": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
