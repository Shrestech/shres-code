{
  "name": "@roos-code/roos-code-session-query-sqlite",
  "description": "Concrete ctx.sessionQuery backend with SQLite FTS5 search",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/session-query/session-query-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-session-persistence": "workspace:^",
    "@roos-code/roos-code-session-query": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@roos-code/roos-code-session-persistence": {
      "optional": true
    }
  },
  "dependencies": {
    "@roos-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/cordis-plugin-loader": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-session-persistence": "workspace:^",
    "@roos-code/roos-code-session-persistence-sqlite": "workspace:^",
    "@roos-code/roos-code-session-query": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
