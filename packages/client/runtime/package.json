{
  "name": "@roos-code/roos-code-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "roos": {
    "client": {
      "inject": [
        "@roos-code/roos-code-client-connection",
        "@roos-code/roos-code-typert-registry",
        "@roos-code/roos-code-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-attachment": "workspace:^",
    "@roos-code/roos-code-client-connection": "workspace:^",
    "@roos-code/roos-code-commands": "workspace:^",
    "@roos-code/roos-code-client-ui-slots": "workspace:^",
    "@roos-code/roos-code-host-apiproxy": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-llm-retry": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-session-projection": "workspace:^",
    "@roos-code/roos-code-session-title": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "immer": "^10.1.1",
    "react": "^18.2.0",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@roos-code/cordis": "workspace:^",
    "@roos-code/roos-code-api-remotes": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-typert-protocol": "workspace:^",
    "@roos-code/roos-code-typert-registry": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/cordis": "workspace:^",
    "@roos-code/roos-code-api-remotes": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-timeout": "workspace:^",
    "@roos-code/roos-code-typert-protocol": "workspace:^",
    "@roos-code/roos-code-typert-registry": "workspace:^",
    "@types/react": "~18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
