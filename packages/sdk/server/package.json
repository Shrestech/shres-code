{
  "name": "@roos-code/roos-code-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Roos Code SDK clients",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@roos-code/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-scope": "workspace:^",
    "@roos-code/roos-code-sdk-protocol": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-subagent": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/cordis-plugin-loader": "workspace:^",
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-agent-spine-demo": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-llm-deepseek": "workspace:^",
    "@roos-code/roos-code-scope": "workspace:^",
    "@roos-code/roos-code-sdk-protocol": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-session-persistence-jsonl": "workspace:^",
    "@roos-code/roos-code-subagent": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
