{
  "name": "@shres-code/shres-code-llm-cursor-session",
  "description": "Cursor subscription-session adapter for the Shres Code: registers the cursor-session provider route over the Cursor Agent CLI's own login credential (via the shared cursor-credential engine), serving the verified model catalog with fail-loud chat diagnostics while the agent wire's proprietary handshake is not replicated",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/llm/llm-cursor-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-cursor-credential": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-cursor-credential": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
