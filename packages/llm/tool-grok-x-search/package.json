{
  "name": "@shres-code/shres-code-tool-grok-x-search",
  "description": "Default-off model-facing X search tools (x_keyword_search, x_semantic_search, x_user_search, x_thread_fetch) that let Shres agents on other routes ask the grok-session route's hosted X search through the Grok subscription",
