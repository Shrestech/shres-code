{
  "name": "@shres-code/shres-code-llm-cli-bridge",
  "description": "Delegated-completion LLM adapter over grok/kimi/codex/claude CLIs",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/llm/llm-cli-bridge"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-credentials": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-launch-environment": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/shres-code-subprocess": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@shres-code/shres-code-credentials": {
      "optional": true
    },
    "@shres-code/shres-code-launch-environment": {
      "optional": true
    },
    "@shres-code/shres-code-session": {
      "optional": true
    },
    "@shres-code/shres-code-settings": {
      "optional": true
    },
    "@shres-code/shres-code-subprocess": {
      "optional": true
    }
  },
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-credentials": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-launch-environment": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/shres-code-subprocess": "workspace:^",
    "@shres-code/shres-code-subprocess-local": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
