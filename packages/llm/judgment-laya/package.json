{
  "name": "@shres-code/shres-code-judgment-laya",
  "description": "Local Laya typed-judgment provider with a supervised laya-mlx gateway",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/llm/judgment-laya"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-commands": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-judgment": "workspace:^",
    "@shres-code/shres-code-judgment-shield": "workspace:^",
    "@shres-code/shres-code-subprocess": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/shres-code-typert-protocol": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@shres-code/shres-code-commands": {
      "optional": true
    }
  },
  "dependencies": {
    "@shres-code/schemastery": "workspace:^",
    "@shres-code/shres-code-home-paths": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@shres-code/cordis-plugin-include": "workspace:^",
    "@shres-code/cordis-plugin-loader": "workspace:^",
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-agent-default-model": "workspace:^",
    "@shres-code/shres-code-agent-loop": "workspace:^",
    "@shres-code/shres-code-commands": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-judgment": "workspace:^",
    "@shres-code/shres-code-judgment-dispatch": "workspace:^",
    "@shres-code/shres-code-judgment-shield": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-llm-deepseek": "workspace:^",
    "@shres-code/shres-code-llm-mock-server": "workspace:^",
    "@shres-code/shres-code-model-router": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-session-projection": "workspace:^",
    "@shres-code/shres-code-subprocess": "workspace:^",
    "@shres-code/shres-code-subprocess-local": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/shres-code-typert-protocol": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
