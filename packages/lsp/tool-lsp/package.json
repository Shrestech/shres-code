{
  "name": "@roos-code/roos-code-tool-lsp",
  "description": "Model-facing lsp tool over the Roos Code LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roos-code/roos-code.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-lsp": "workspace:^",
    "@roos-code/roos-code-system-prompt": "workspace:^",
    "@roos-code/roos-code-timeout": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@roos-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@roos-code/roos-code-agent": "workspace:^",
    "@roos-code/roos-code-fs-local": "workspace:^",
    "@roos-code/roos-code-invariants": "workspace:^",
    "@roos-code/roos-code-llm": "workspace:^",
    "@roos-code/roos-code-lsp": "workspace:^",
    "@roos-code/roos-code-lsp-stdio": "workspace:^",
    "@roos-code/roos-code-session": "workspace:^",
    "@roos-code/roos-code-subprocess-local": "workspace:^",
    "@roos-code/roos-code-system-prompt": "workspace:^",
    "@roos-code/roos-code-timeout": "workspace:^",
    "@roos-code/roos-code-tool-call-timeout-policy": "workspace:^",
    "@roos-code/roos-code-tools": "workspace:^",
    "@roos-code/cordis": "workspace:^"
  }
}
