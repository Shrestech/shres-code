{
  "name": "@shres-code/shres-code-wiki-librarian",
  "description": "Cheap-model wiki librarian seat — batched session-to-page consolidation on a user-bound route, dormant when unbound",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/wiki/wiki-librarian"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-jobs": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/shres-code-wiki": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-agent": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-jobs": "workspace:^",
    "@shres-code/shres-code-llm": "workspace:^",
    "@shres-code/shres-code-llm-deepseek": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-timeout": "workspace:^",
    "@shres-code/shres-code-tools": "workspace:^",
    "@shres-code/shres-code-wiki": "workspace:^",
    "@shres-code/shres-code-wiki-filesystem": "workspace:^",
    "@shres-code/shres-code-system-prompt": "workspace:^",
    "@shres-code/cordis": "workspace:^",
    "@shres-code/cordis-plugin-include": "workspace:^",
    "@shres-code/cordis-plugin-loader": "workspace:^"
  }
}
