{
  "name": "@shres-code/shres-code-wiki-embed-onnx",
  "description": "In-process EmbeddingGemma-300M ONNX embeddings provider for ctx.wiki semantic search, dedup, and link shortlists",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/wiki/wiki-embed-onnx"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-home-paths": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-wiki": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@shres-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-home-paths": "workspace:^",
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-wiki": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
