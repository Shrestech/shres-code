{
  "name": "@shres-code/shres-code-wiki",
  "description": "Abstract wiki capability seam (ctx.wiki) for the Shres Code — long-term markdown memory, temperature/demotion/lint folds, request/spec split, and the log-only wiki/page session event",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmstech/shres-code.git",
    "directory": "packages/wiki/wiki"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  },
  "dependencies": {
    "@shres-code/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@shres-code/shres-code-invariants": "workspace:^",
    "@shres-code/shres-code-session": "workspace:^",
    "@shres-code/shres-code-settings": "workspace:^",
    "@shres-code/cordis": "workspace:^"
  }
}
